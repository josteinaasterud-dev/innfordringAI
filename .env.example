# Entra ID – appregistrering for MCP-serveren.
# Lag en EGEN registrering for denne integrasjonen. Ikke gjenbruk
# authenticate-app eller user-sync-app, slik at den kan trekkes tilbake alene.
BANQSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
BANQSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
BANQSOFT_CLIENT_SECRET=
BANQSOFT_API_SCOPE=api://<application-id-uri>/.default

# Lighthouse
BANQSOFT_NAMESPACE=ecm-se
BANQSOFT_ENVIRONMENT=sandbox

# Drift
BANQSOFT_AUDIT_LOG_PATH=./logs/banqsoft-audit.jsonl
BANQSOFT_MAX_RESULT_ROWS=50

# Overstyr stier når Banqsoft har bekreftet endepunktene
# BANQSOFT_CASES_SERVICE=casesapi
# BANQSOFT_PATH_CASE=/api/v1/cases/{case_number}
# BANQSOFT_PATH_CASE_PAYMENTS=/api/v1/cases/{case_number}/payments
# BANQSOFT_PATH_CASE_SEARCH=/api/v1/cases
